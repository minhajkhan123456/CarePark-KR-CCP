ce_of", "Department" ],  ["noor", "instance_of", "Patient" ],  ["noor", "instance_of", "BadgeHolder" ],  ["wv_no", "instance_of", "WheelchairVan" ],  ["noor", "drives", "wv_no" ],  ["noor", "has", "appt_noor" ],  ["appt_noor", "instance_of", "Appointment" ],  ["appt_noor", "at", "oncology" ],  ["oncology", "instance_of", "Department" ],  ["faisal", "instance_of", "Paramedic" ],  ["amb_fa", "instance_of", "Ambulance" ],  ["faisal", "drives", "amb_fa" ],  ["amb1", "instance_of", "AmbulanceBay" ],  ["amb1", "part_of", "z_amb" ],  ["z_amb", "instance_of", "Zone" ],  ["z_amb", "part_of", "g" ],  ["g", "instance_of", "Level" ],  ["rukhsana", "instance_of", "ExpectantMother" ],  ["rukhsana", "instance_of", "Visitor" ],  ["rukhsana", "visits", "maternity" ],  ["maternity", "instance_of", "Department" ] ], "fol": [ {"id":"f1", "english":"Doctors, nurses, admin officers and paramedics are staff", "formula":"∀x (Doctor(x) ∨ Nurse(x) ∨ Admin(x) ∨ Paramedic(x) → Staff(x))", "runs":"h1-h4", "horn":"true", "check":""},  {"id":"f2", "english":"Staff, patients, visitors and suppliers are persons", "formula":"∀x (Staff(x) ∨ Patient(x) ∨ Visitor(x) ∨ Supplier(x) → Person(x))", "runs":"h7-h10", "horn":"true", "check":""},  {"id":"f3", "english":"Every person has at least one role", "formula":"∀x (Person(x) → Staff(x) ∨ Patient(x) ∨ Visitor(x) ∨ Supplier(x))", "runs":"model check", "horn":"false", "check":"holds"},  {"id":"f4", "english":"Every vehicle has exactly one class", "formula":"∀v (Vehicle(v) → ∃!c Class(v,c))", "runs":"IC6", "horn":"false", "check":"holds"},  {"id":"f5", "english":"Every vehicle at the gate has exactly one driver", "formula":"∀v (Arrives(v) → ∃d (Drives(d,v) ∧ ∀d′ (Drives(d′,v) → d′ = d)))", "runs":"IC5", "horn":"false", "check":"holds"},  {"id":"f6", "english":"Identified iff the plate read is at least 90%", "formula":"∀v (Identified(v) ↔ ∃c (Anpr(v,c) ∧ c ≥ 90))", "runs":"s1", "horn":"true", "check":""},  {"id":"f7", "english":"A badge is valid iff today lies between issue and expiry", "formula":"∀p (BadgeValid(p) ↔ ∃i ∃e ∃t (Badge(p,i,e) ∧ Today(t) ∧ i ≤ t ≤ e))", "runs":"s4", "horn":"true", "check":""},  {"id":"f8", "english":"On shift from 30 minutes before the start to the end", "formula":"∀p (OnShift(p) ↔ ∃s ∃e ∃v ∃t (Shift(p,s,e) ∧ Drives(p,v) ∧ Arrival(v,t) ∧ s − 30 ≤ t ≤ e))", "runs":"t1", "horn":"true", "check":""},  {"id":"f9", "english":"Appointment window is −60 to +30 minutes", "formula":"∀p (InWindow(p) ↔ ∃d ∃a ∃v ∃t (Appt(p,d,a) ∧ Drives(p,v) ∧ Arrival(v,t) ∧ a − 60 ≤ t ≤ a + 30))", "runs":"t2", "horn":"true", "check":""},  {"id":"f10", "english":"Visiting time is inside a visiting window", "formula":"∀v (VisitingTime(v) ↔ ∃t ∃a ∃b (Arrival(v,t) ∧ Window(a,b) ∧ a ≤ t < b))", "runs":"t3", "horn":"true", "check":""},  {"id":"f11", "english":"A banned person is never cleared", "formula":"∀p (Banned(p) → ¬Cleared(p))", "runs":"a1-a4 with NAF", "horn":"false", "check":"holds"},  {"id":"f12", "english":"Clearance by role", "formula":"∀p (Staff(p) ∧ BadgeValid(p) ∧ ¬Banned(p) → Cleared(p))", "runs":"a1-a4", "horn":"true", "check":""},  {"id":"f13", "english":"Emergencies are always admitted", "formula":"∀v (EmergencyVehicle(v) ∨ DeclaredEmergency(v) → Admitted(v))", "runs":"a5, a6", "horn":"true", "check":""},  {"id":"f14", "english":"Admission of identified, cleared drivers", "formula":"∀v (∃p (Arrival(v) ∧ Identified(v) ∧ Drives(p,v) ∧ Cleared(p)) → Admitted(v))", "runs":"a7", "horn":"true", "check":""},  {"id":"f15", "english":"Every admitted vehicle came through the gate", "formula":"∀v (Admitted(v) → ∃t Arrival(v,t))", "runs":"model check", "horn":"false", "check":"holds"},  {"id":"f16", "english":"Fit: class compatible and height under route clearance", "formula":"∀v ∀b (Fits(v,b) ↔ ∃c ∃t ∃h ∃l ∃k (Class(v,c) ∧ Type(b,t) ∧ ClassFits(c,t) ∧ Height(v,h) ∧ LevelOf(b,l) ∧ Clear(l,k) ∧ h ≤ k))", "runs":"f1", "horn":"true", "check":""},  {"id":"f17", "english":"Nothing taller than 210 cm is placed above ground", "formula":"∀v ∀b (Alloc(v,b) ∧ Height(v,h) ∧ h > 210 → LevelOf(b,g))", "runs":"IC3", "horn":"false", "check":"holds"},  {"id":"f18", "english":"Entitlement by zone kind", "formula":"∀v ∀z (Entitled(v,z) ← … one clause per zone kind, e1-e15)", "runs":"e1-e15", "horn":"true", "check":""},  {"id":"f19", "english":"In code red no visitor is entitled to the visitor zone", "formula":"∀v ∀z (CodeRed ∧ Visitor(v) ∧ Kind(z,visitor) → ¬Entitled(v,z))", "runs":"e11 with NAF", "horn":"false", "check":"holds"},  {"id":"f20", "english":"A candidate bay fits, is entitled and usable", "formula":"∀v ∀b (Candidate(v,b) ↔ Admitted(v) ∧ Fits(v,b) ∧ ∃z (InZone(b,z) ∧ Entitled(v,z)) ∧ Usable(b))", "runs":"c1", "horn":"true", "check":""},  {"id":"f21", "english":"Every allocated bay was a candidate", "formula":"∀v ∀b (Alloc(v,b) → Candidate(v,b))", "runs":"model check", "horn":"false", "check":"holds"},  {"id":"f22", "english":"Each admitted vehicle with a free candidate gets exactly one bay", "formula":"∀v (Admitted(v) ∧ ∃b FreeCandidate(v,b) → ∃!b Alloc(v,b))", "runs":"control layer", "horn":"false", "check":"holds"},  {"id":"f23", "english":"No bay holds two vehicles at the same time", "formula":"∀b ∀v₁ ∀v₂ (Alloc(v₁,b,[s₁,e₁]) ∧ Alloc(v₂,b,[s₂,e₂]) ∧ v₁ ≠ v₂ → e₁ ≤ s₂ ∨ e₂ ≤ s₁)", "runs":"IC1", "horn":"false", "check":"holds"},  {"id":"f24", "english":"The chosen bay has minimum cost among bays free at that moment", "formula":"∀v ∀b (Alloc(v,b,t) → ¬∃b′ (Free(b′,t) ∧ Cost(v,b′) < Cost(v,b)))", "runs":"control layer", "horn":"false", "check":"holds"},  {"id":"f25", "english":"Higher priority is served first at the same minute", "formula":"∀v₁ ∀v₂ (Arr(v₁)=Arr(v₂) ∧ Pri(v₁) < Pri(v₂) → Served(v₁) < Served(v₂))", "runs":"control layer", "horn":"false", "check":"holds"},  {"id":"f26", "english":"Ambulance bays are for emergency vehicles only", "formula":"∀v ∀b (Occupies(v,b) ∧ Type(b,amb) → EmergencyVehicle(v))", "runs":"w3 alert", "horn":"false", "check":"holds"},  {"id":"f27", "english":"Accessible bays are allocated only to badge holders", "formula":"∀v ∀b (Alloc(v,b) ∧ Type(b,acc) → ∃p (Drives(p,v) ∧ Badge(p)))", "runs":"e3", "horn":"false", "check":"holds"},  {"id":"f28", "english":"Every bay lies in exactly one zone", "formula":"∀b (Bay(b) → ∃!z InZone(b,z))", "runs":"IC7", "horn":"false", "check":"holds"},  {"id":"f29", "english":"Every zone is on exactly one level", "formula":"∀z (Zone(z) → ∃!l Level(z,l))", "runs":"model check", "horn":"false", "check":"holds"},  {"id":"f30", "english":"Drop-off stays are short", "formula":"∀v (Alloc(v,b) ∧ Type(b,drop) ∧ Stay(v,s) ∧ s > Limit(v) → Overstay(v))", "runs":"w6-w8", "horn":"true", "check":""},  {"id":"f31", "english":"Fee schedule", "formula":"∀v (Patient(v) ∧ Stay(v,s) ∧ s > 120 → Fee(v, 50·⌈(s−120)/60⌉))", "runs":"m1-m7", "horn":"true", "check":""},  {"id":"f32", "english":"Every admitted vehicle has a fee or is exempt", "formula":"∀v (Alloc(v,b) → ∃f Fee(v,f))", "runs":"model check", "horn":"false", "check":"holds"},  {"id":"f33", "english":"Shifts end after they start", "formula":"∀p ∀s ∀e (Shift(p,s,e) → s < e)", "runs":"IC8", "horn":"false", "check":"holds"},  {"id":"f34", "english":"Only patients hold appointments", "formula":"∀p (∃d ∃t Appt(p,d,t) → Patient(p))", "runs":"IC10", "horn":"false", "check":"holds"},  {"id":"f35", "english":"Nobody is both staff and a visitor", "formula":"∀x ¬(Staff(x) ∧ Visitor(x))", "runs":"IC13", "horn":"false", "check":"holds"},  {"id":"f36", "english":"Some bay is always reserved for emergencies", "formula":"∃b (Type(b,amb) ∧ ¬OutOfService(b))", "runs":"model check", "horn":"false", "check":"holds"} ], "tbox": {"subsumption": ["Staff ⊑ Person", "Patient ⊑ Person", "Visitor ⊑ Person", "Supplier ⊑ Person", "Doctor ⊑ Staff", "Nurse ⊑ Staff", "Paramedic ⊑ Staff", "AdminOfficer ⊑ Staff", "Clinician ⊑ Staff", "OnCallDoctor ⊑ Doctor", "BadgeHolder ⊑ Person", "ExpectantMother ⊑ Person", "ClearedPerson ⊑ Person", "BannedPerson ⊑ Person", "OnShiftStaff ⊑ Staff",